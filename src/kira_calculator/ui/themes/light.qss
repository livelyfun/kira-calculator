/* ============================================================================
   Kira Calculator - Light Theme (Refined Commercial Desktop UI)
============================================================================ */

QMainWindow, QWidget#centralWidget {
    background-color: #f4f4f5;
    color: #18181b;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Ubuntu, sans-serif;
}

QWidget {
    background-color: transparent;
    color: #18181b;
    font-size: 13px;
}

QLabel {
    background-color: transparent;
    color: #3f3f46;
    font-size: 13px;
    border: none;
    padding: 0px;
}

/* Display Widget */
QFrame#displayFrame {
    background-color: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 12px;
    padding: 10px 16px;
}

QLabel#displayExpression {
    color: #71717a;
    font-size: 14px;
    font-weight: 400;
    min-height: 20px;
}

QLabel#displayResult {
    color: #09090b;
    font-size: 38px;
    font-weight: 600;
    min-height: 48px;
}

QLabel#displayStatus {
    color: #0284c7;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Keypad Buttons */
QPushButton {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 500;
    min-height: 42px;
    padding: 6px;
}

QPushButton:hover {
    background-color: #f4f4f5;
    border-color: #d4d4d8;
}

QPushButton:pressed {
    background-color: #e4e4e7;
}

QPushButton:disabled {
    background-color: #f4f4f5;
    color: #a1a1aa;
    border-color: #e4e4e7;
}

QPushButton#numberButton {
    background-color: #ffffff;
    color: #09090b;
    font-size: 17px;
    font-weight: 600;
    border: 1px solid #e4e4e7;
}

QPushButton#numberButton:hover {
    background-color: #f4f4f5;
}

QPushButton#operatorButton {
    background-color: #ede9fe;
    color: #5b21b6;
    font-size: 18px;
    font-weight: 600;
    border: 1px solid #ddd6fe;
}

QPushButton#operatorButton:hover {
    background-color: #ddd6fe;
}

QPushButton#equalsButton {
    background-color: #2563eb;
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
    border: 1px solid #1d4ed8;
}

QPushButton#equalsButton:hover {
    background-color: #1d4ed8;
}

QPushButton#clearButton, QPushButton#backspaceButton {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
    font-weight: 600;
}

QPushButton#clearButton:hover, QPushButton#backspaceButton:hover {
    background-color: #fecaca;
}

QPushButton#scientificButton {
    background-color: #e0f2fe;
    color: #0369a1;
    border: 1px solid #bae6fd;
    font-size: 14px;
}

QPushButton#scientificButton:hover {
    background-color: #bae6fd;
}

/* Mode Bar */
QFrame#navigationBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e4e4e7;
    padding: 4px 8px;
}

QPushButton#navButton {
    background-color: transparent;
    color: #71717a;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 12px;
    min-height: 28px;
}

QPushButton#navButton:hover {
    background-color: #f4f4f5;
    color: #18181b;
}

QPushButton#navButton:checked, QPushButton#navButton[active="true"] {
    background-color: #f4f4f5;
    color: #0284c7;
    font-weight: 600;
}

QPushButton#iconButton {
    background-color: transparent;
    color: #71717a;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px;
    min-height: 28px;
    min-width: 28px;
}

QPushButton#iconButton:hover {
    background-color: #f4f4f5;
    color: #18181b;
    border-color: #e4e4e7;
}

/* Inputs */
QLineEdit {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid #d4d4d8;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 15px;
    selection-background-color: #2563eb;
}

QLineEdit:focus {
    border: 1px solid #2563eb;
}

QComboBox {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid #d4d4d8;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    min-height: 26px;
}

QComboBox:hover {
    border-color: #a1a1aa;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid #d4d4d8;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

/* History */
QFrame#historyDrawer {
    background-color: #ffffff;
    border-left: 1px solid #e4e4e7;
    padding: 12px;
}

QLabel#historyHeaderTitle {
    color: #09090b;
    font-size: 15px;
    font-weight: 600;
}

QListWidget#historyList {
    background-color: transparent;
    border: none;
    color: #18181b;
    outline: none;
}

QListWidget#historyList::item {
    background-color: #f4f4f5;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    margin-bottom: 6px;
    padding: 8px 10px;
}

QListWidget#historyList::item:hover {
    background-color: #e4e4e7;
}

QListWidget#historyList::item:selected {
    background-color: #dbeafe;
    border-color: #3b82f6;
    color: #1e3a8a;
}

/* Programmer Mode Specials */
QLabel#programmerBits {
    background-color: #f4f4f5;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    color: #0284c7;
    font-family: "JetBrains Mono", "Cascadia Code", "Fira Code", monospace;
    font-size: 13px;
    font-weight: 500;
    padding: 8px;
    letter-spacing: 2px;
}

QLabel#programmerRadixValue {
    color: #27272a;
    font-family: monospace;
    font-size: 13px;
    font-weight: 500;
}

