/* ============================================================================
   Kira Calculator - Dark Theme (Refined Commercial Desktop UI)
============================================================================ */

/* Base Window & Containers */
QMainWindow, QWidget#centralWidget {
    background-color: #121214;
    color: #f4f4f5;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Ubuntu, sans-serif;
}

QWidget {
    background-color: transparent;
    color: #f4f4f5;
    font-size: 13px;
}

/* Generic Labels */
QLabel {
    background-color: transparent;
    color: #d4d4d8;
    font-size: 13px;
    border: none;
    padding: 0px;
}

/* ============================================================================
   Display Widget
============================================================================ */

QFrame#displayFrame {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
    padding: 10px 16px;
}

QLabel#displayExpression {
    color: #a1a1aa;
    font-size: 14px;
    font-weight: 400;
    min-height: 20px;
    background: transparent;
}

QLabel#displayResult {
    color: #ffffff;
    font-size: 38px;
    font-weight: 600;
    min-height: 48px;
    background: transparent;
}

QLabel#displayStatus {
    color: #38bdf8;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    background: transparent;
}

/* ============================================================================
   Keypad Buttons
============================================================================ */

QPushButton {
    background-color: #27272a;
    color: #fafafa;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 500;
    min-height: 42px;
    padding: 6px;
}

QPushButton:hover {
    background-color: #3f3f46;
    border-color: #52525b;
}

QPushButton:pressed {
    background-color: #18181b;
    border-color: #71717a;
}

QPushButton:disabled {
    background-color: #1c1c1f;
    color: #52525b;
    border-color: #27272a;
}

/* Number Buttons */
QPushButton#numberButton {
    background-color: #202023;
    color: #ffffff;
    font-size: 17px;
    font-weight: 600;
    border: 1px solid #2e2e33;
}

QPushButton#numberButton:hover {
    background-color: #2e2e33;
    border-color: #3f3f46;
}

/* Operator Buttons */
QPushButton#operatorButton {
    background-color: #2d2640;
    color: #c4b5fd;
    font-size: 18px;
    font-weight: 600;
    border: 1px solid #4338ca;
}

QPushButton#operatorButton:hover {
    background-color: #3730a3;
    color: #ffffff;
}

/* Equals Button */
QPushButton#equalsButton {
    background-color: #2563eb;
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
    border: 1px solid #3b82f6;
}

QPushButton#equalsButton:hover {
    background-color: #1d4ed8;
    border-color: #60a5fa;
}

QPushButton#equalsButton:pressed {
    background-color: #1e40af;
}

/* Clear / Action Buttons */
QPushButton#clearButton, QPushButton#backspaceButton {
    background-color: #3b1820;
    color: #fca5a5;
    border: 1px solid #7f1d1d;
    font-weight: 600;
}

QPushButton#clearButton:hover, QPushButton#backspaceButton:hover {
    background-color: #991b1b;
    color: #ffffff;
}

/* Scientific Buttons */
QPushButton#scientificButton {
    background-color: #1e293b;
    color: #93c5fd;
    border: 1px solid #334155;
    font-size: 14px;
}

QPushButton#scientificButton:hover {
    background-color: #334155;
    color: #ffffff;
}

/* ============================================================================
   Mode Bar & Navigation
============================================================================ */

QFrame#navigationBar {
    background-color: #18181b;
    border-bottom: 1px solid #27272a;
    padding: 4px 8px;
}

QPushButton#navButton {
    background-color: transparent;
    color: #a1a1aa;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 12px;
    min-height: 28px;
}

QPushButton#navButton:hover {
    background-color: #27272a;
    color: #ffffff;
}

QPushButton#navButton:checked, QPushButton#navButton[active="true"] {
    background-color: #27272a;
    color: #38bdf8;
    font-weight: 600;
}

QPushButton#iconButton {
    background-color: transparent;
    color: #a1a1aa;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px;
    min-height: 28px;
    min-width: 28px;
}

QPushButton#iconButton:hover {
    background-color: #27272a;
    color: #ffffff;
    border-color: #3f3f46;
}

/* ============================================================================
   Inputs & Dropdowns
============================================================================ */

QLineEdit {
    background-color: #18181b;
    color: #ffffff;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 15px;
    selection-background-color: #2563eb;
}

QLineEdit:focus {
    border: 1px solid #3b82f6;
}

QComboBox {
    background-color: #27272a;
    color: #fafafa;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    min-height: 26px;
}

QComboBox:hover {
    border-color: #52525b;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #18181b;
    color: #ffffff;
    border: 1px solid #3f3f46;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    padding: 4px;
}

/* ============================================================================
   History Panel
============================================================================ */

QFrame#historyDrawer {
    background-color: #18181b;
    border-left: 1px solid #27272a;
    padding: 12px;
}

QLabel#historyHeaderTitle {
    color: #fafafa;
    font-size: 15px;
    font-weight: 600;
}

QListWidget#historyList {
    background-color: transparent;
    border: none;
    color: #ffffff;
    outline: none;
}

QListWidget#historyList::item {
    background-color: #202023;
    border: 1px solid #27272a;
    border-radius: 8px;
    margin-bottom: 6px;
    padding: 8px 10px;
}

QListWidget#historyList::item:hover {
    background-color: #27272a;
    border-color: #3f3f46;
}

QListWidget#historyList::item:selected {
    background-color: #262c3d;
    border-color: #3b82f6;
}

/* ============================================================================
   Programmer Mode Specials
============================================================================ */

QLabel#programmerBits {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 8px;
    color: #38bdf8;
    font-family: "JetBrains Mono", "Cascadia Code", "Fira Code", monospace;
    font-size: 13px;
    font-weight: 500;
    padding: 8px;
    letter-spacing: 2px;
}

QLabel#programmerRadixValue {
    color: #e4e4e7;
    font-family: monospace;
    font-size: 13px;
    font-weight: 500;
}

