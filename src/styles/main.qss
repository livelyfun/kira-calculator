/* ==========================================
   Main Window
========================================== */

QMainWindow {
    background-color: #202124;
}

QWidget {
    background-color: #202124;
}


/* ==========================================
   Display
========================================== */

QLabel {

    background-color: #2b2b2b;
    color: white;

    font-size: 36px;
    font-weight: bold;

    border: 2px solid #444444;
    border-radius: 15px;

    padding: 20px;
}


/* ==========================================
   Number Buttons
========================================== */

QPushButton#numberButton {

    background-color: #3b3b3b;
    color: white;

    font-size: 22px;

    border: none;
    border-radius: 12px;

    min-height: 75px;
}

QPushButton#numberButton:hover {
    background-color: #505050;
}

QPushButton#numberButton:pressed {
    background-color: #707070;
}


/* ==========================================
   Operator Buttons
========================================== */

QPushButton#operatorButton {

    background-color: #1f6feb;
    color: white;

    font-size: 22px;

    border: none;
    border-radius: 12px;

    min-height: 75px;
}

QPushButton#operatorButton:hover {
    background-color: #388bfd;
}

QPushButton#operatorButton:pressed {
    background-color: #0d419d;
}


/* ==========================================
   Equals Button
========================================== */

QPushButton#equalsButton {

    background-color: #238636;
    color: white;

    font-size: 22px;

    font-weight: bold;

    border: none;
    border-radius: 12px;

    min-height: 75px;
}

QPushButton#equalsButton:hover {
    background-color: #2ea043;
}

QPushButton#equalsButton:pressed {
    background-color: #196c2e;
}


/* ==========================================
   Clear Button
========================================== */

QPushButton#clearButton {

    background-color: #da3633;
    color: white;

    font-size: 22px;

    font-weight: bold;

    border: none;
    border-radius: 12px;

    min-height: 75px;
}

QPushButton#backspaceButton {

    background-color: #8b5cf6;
    color: white;

    font-size: 22px;

    font-weight: bold;

    border: none;
    border-radius: 12px;

    min-height: 75px;
}

QPushButton#backspaceButton:hover {
    background-color: #9f6eff;
}

QPushButton#backspaceButton:pressed {
    background-color: #6d3fd6;
}

QPushButton#clearButton:hover {
    background-color: #f85149;
}

QPushButton#clearButton:pressed {
    background-color: #b62324;
}

/* ==========================================
   History Panel
========================================== */

QListWidget#history {

    background-color: #2b2b2b;

    color: white;

    border: 2px solid #444444;

    border-radius: 12px;

    font-size: 18px;

    padding: 15px;

    min-width: 230px;
}

/* ==========================================
   History Title
========================================== */

QLabel#historyTitle {

    color: white;

    font-size: 22px;

    font-weight: bold;

    padding-left: 6px;
}

/* ==========================================
   Clear History Button
========================================== */

QPushButton#clearHistoryButton {

    background-color: #444444;

    color: white;

    border-radius: 10px;

    min-height: 45px;

    font-size: 16px;
}

QPushButton#clearHistoryButton:hover {

    background-color: #555555;
}

QPushButton#clearHistoryButton:pressed {

    background-color: #333333;
}

QScrollBar:vertical {

    background: #2b2b2b;

    width: 12px;

    border-radius: 6px;
}

QScrollBar::handle:vertical {

    background: #666666;

    border-radius: 6px;

    min-height: 40px;
}

QScrollBar::handle:vertical:hover {

    background: #888888;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {

    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {

    background: none;
}